      "parameters": {
        "jsCode": "// Extract error context provided by the n8n Error Trigger\nconst errorData = $input.first().json;\n\nreturn [{\n  json: {\n    workflowName: errorData.workflow?.name || 'Unknown Workflow',\n    workflowId: errorData.workflow?.id || 'N/A',\n    executionId: errorData.execution?.id || 'N/A',\n    errorMessage: errorData.execution?.error?.message || 'No detailed error message provided',\n    nodeName: errorData.execution?.error?.node?.name || 'Unknown Node',\n    timestamp: new Date().toISOString()\n  }\n}];"
